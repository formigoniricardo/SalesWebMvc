@model Seller
@{
    ViewData["Title"] = Model.Name;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Vendedores</a></li><li class="breadcrumb-item active">Detalhes</li></ol></nav>
        <div class="cell-person">
            <span class="avatar avatar-lg">@Format.Initials(Model.Name)</span>
            <div>
                <h1 class="page-title">@Model.Name</h1>
                <p class="page-subtitle"><i class="bi bi-envelope me-1"></i>@Model.Email</p>
            </div>
        </div>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i> Editar</a>
        <button type="button" class="btn btn-ghost" data-delete-url="@Url.Action("Delete", new { id = Model.Id })" data-delete-name="@Model.Name">
            <i class="bi bi-trash3 me-1"></i> Excluir
        </button>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-5">
        <section class="card-app h-100">
            <div class="card-app-header"><h2 class="card-app-title">Informações</h2></div>
            <div class="card-app-body">
                <dl class="detail-list">
                    <dt>Departamento</dt>
                    <dd><span class="dept-chip">@Model.Department?.Name</span></dd>
                    <dt>Data de nascimento</dt>
                    <dd>@Format.Date(Model.BirthDate)</dd>
                    <dt>Salário base</dt>
                    <dd class="amount">@Format.Money(Model.BaseSalary)</dd>
                </dl>
            </div>
        </section>
    </div>
    <div class="col-12 col-lg-7">
        <section class="card-app h-100">
            <div class="card-app-header">
                <div>
                    <h2 class="card-app-title">Vendas recentes</h2>
                    <p class="card-app-subtitle">Últimas 10 vendas deste vendedor</p>
                </div>
                <a asp-controller="SalesRecords" asp-action="Index" asp-route-search="@Model.Name" class="btn btn-sm btn-ghost">Ver todas <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
            @if (!Model.Sales.Any())
            {
                <div class="empty-state"><i class="bi bi-inbox"></i>Nenhuma venda registrada.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-app table-hover table-stack">
                        <thead><tr><th>Data</th><th class="text-end">Valor</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var sale in Model.Sales)
                            {
                                <tr>
                                    <td data-label="Data">@Format.Date(sale.Date)</td>
                                    <td data-label="Valor" class="text-end amount">@Format.Money(sale.Amount)</td>
                                    <td data-label="Status"><status-badge status="@sale.Status" /></td>
                                    <td>
                                        <div class="row-actions">
                                            <a asp-controller="SalesRecords" asp-action="Details" asp-route-id="@sale.Id" class="btn-icon" title="Detalhes" aria-label="Detalhes da venda #@sale.Id"><i class="bi bi-eye"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-ghost"><i class="bi bi-arrow-left me-1"></i> Voltar para a lista</a>
</div>

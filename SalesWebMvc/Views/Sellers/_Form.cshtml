@model SellerFormViewModel

<div asp-validation-summary="ModelOnly"></div>

<div class="row g-3">
    <div class="col-12 col-md-6">
        <label asp-for="Seller.Name" class="form-label"></label>
        <input asp-for="Seller.Name" class="form-control" placeholder="Nome completo" autocomplete="name" />
        <span asp-validation-for="Seller.Name"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="Seller.Email" class="form-label"></label>
        <input asp-for="Seller.Email" type="email" class="form-control" placeholder="nome@empresa.com" autocomplete="email" />
        <span asp-validation-for="Seller.Email"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="Seller.BirthDate" class="form-label"></label>
        <input asp-for="Seller.BirthDate" type="date" class="form-control" max="@DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd")" />
        <span asp-validation-for="Seller.BirthDate"></span>
        <div class="form-hint">O vendedor deve ser maior de 18 anos.</div>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="Seller.BaseSalary" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">R$</span>
            <input asp-for="Seller.BaseSalary" type="number" step="0.01" min="0" class="form-control" placeholder="0,00" />
        </div>
        <span asp-validation-for="Seller.BaseSalary"></span>
    </div>
    <div class="col-12">
        <label asp-for="Seller.DepartmentId" class="form-label"></label>
        <select asp-for="Seller.DepartmentId" asp-items="@(new SelectList(Model.Departments, "Id", "Name"))" class="form-select">
            <option value="">Selecione um departamento…</option>
        </select>
        <span asp-validation-for="Seller.DepartmentId"></span>
    </div>
</div>

@model SellerListViewModel
@{
    ViewData["Title"] = "Vendedores";
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || Model.DepartmentId.HasValue;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li><li class="breadcrumb-item active">Vendedores</li></ol></nav>
        <h1 class="page-title">Vendedores</h1>
        <p class="page-subtitle">Gerencie a equipe comercial e seus departamentos.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i> Novo vendedor</a>
    </div>
</div>

<section class="card-app">
    <form method="get" asp-action="Index" class="card-app-header">
        <div class="filter-bar flex-grow-1">
            <div>
                <label class="form-label" for="search">Buscar</label>
                <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Nome ou e-mail" />
            </div>
            <div>
                <label class="form-label" for="departmentId">Departamento</label>
                <select class="form-select" id="departmentId" name="departmentId" data-autosubmit>
                    <option value="">Todos</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
                    }
                </select>
            </div>
            <div class="filter-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i> Buscar</button>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="btn btn-ghost" title="Limpar filtros" aria-label="Limpar filtros"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </div>
    </form>

    @if (Model.Sellers.TotalCount == 0)
    {
        <div class="empty-state">
            <i class="bi bi-people"></i>
            @(hasFilters ? "Nenhum vendedor encontrado com os filtros aplicados." : "Nenhum vendedor cadastrado ainda.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-app table-hover table-stack">
                <thead>
                    <tr>
                        <th>Vendedor</th>
                        <th>Departamento</th>
                        <th>Nascimento</th>
                        <th class="text-end">Salário base</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Sellers.Items)
                    {
                        <tr>
                            <td class="cell-main">
                                <div class="cell-person">
                                    <span class="avatar">@Format.Initials(item.Name)</span>
                                    <span>
                                        <span class="name">@item.Name</span>
                                        <span class="sub">@item.Email</span>
                                    </span>
                                </div>
                            </td>
                            <td data-label="Departamento"><span class="dept-chip">@item.Department?.Name</span></td>
                            <td data-label="Nascimento">@Format.Date(item.BirthDate)</td>
                            <td data-label="Salário base" class="text-end amount">@Format.Money(item.BaseSalary)</td>
                            <td>
                                <div class="row-actions">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-icon" title="Detalhes" aria-label="Detalhes de @item.Name"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon" title="Editar" aria-label="Editar @item.Name"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn-icon danger" title="Excluir" aria-label="Excluir @item.Name"
                                            data-delete-url="@Url.Action("Delete", new { id = item.Id })" data-delete-name="@item.Name">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model.Sellers" />
    }
</section>

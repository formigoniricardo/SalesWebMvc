@model SellerFormViewModel
@{
    ViewData["Title"] = "Novo vendedor";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Vendedores</a></li><li class="breadcrumb-item active">Novo</li></ol></nav>
        <h1 class="page-title">Novo vendedor</h1>
        <p class="page-subtitle">Cadastre um novo membro da equipe comercial.</p>
    </div>
</div>

<section class="card-app form-card">
    <form asp-action="Create" novalidate>
        <div class="card-app-body">
            <partial name="_Form" model="Model" />
        </div>
        <div class="card-app-header justify-content-end border-top border-bottom-0">
            <a asp-action="Index" class="btn btn-ghost">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i> Cadastrar</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

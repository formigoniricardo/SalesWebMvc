@model Department
@{
    ViewData["Title"] = Model.Name;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Departamentos</a></li><li class="breadcrumb-item active">Detalhes</li></ol></nav>
        <h1 class="page-title">@Model.Name</h1>
        <p class="page-subtitle">@Model.Sellers.Count vendedor(es) neste departamento</p>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i> Editar</a>
        <a asp-controller="SalesRecords" asp-action="Index" asp-route-departmentId="@Model.Id" class="btn btn-ghost"><i class="bi bi-receipt me-1"></i> Ver vendas</a>
    </div>
</div>

<section class="card-app">
    <div class="card-app-header"><h2 class="card-app-title">Equipe</h2></div>
    @if (!Model.Sellers.Any())
    {
        <div class="empty-state"><i class="bi bi-people"></i>Nenhum vendedor neste departamento.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-app table-hover table-stack">
                <thead><tr><th>Vendedor</th><th class="text-end">Salário base</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in Model.Sellers)
                    {
                        <tr>
                            <td class="cell-main">
                                <div class="cell-person">
                                    <span class="avatar avatar-sm">@Format.Initials(s.Name)</span>
                                    <span><span class="name">@s.Name</span><span class="sub">@s.Email</span></span>
                                </div>
                            </td>
                            <td data-label="Salário base" class="text-end amount">@Format.Money(s.BaseSalary)</td>
                            <td>
                                <div class="row-actions">
                                    <a asp-controller="Sellers" asp-action="Details" asp-route-id="@s.Id" class="btn-icon" title="Detalhes" aria-label="Detalhes de @s.Name"><i class="bi bi-eye"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-ghost"><i class="bi bi-arrow-left me-1"></i> Voltar para a lista</a>
</div>

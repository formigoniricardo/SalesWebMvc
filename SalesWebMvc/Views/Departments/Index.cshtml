@model IEnumerable<DepartmentListItem>
@{
    ViewData["Title"] = "Departamentos";
    var maxTotal = Model.Any() ? Model.Max(d => d.BilledTotal) : 0;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li><li class="breadcrumb-item active">Departamentos</li></ol></nav>
        <h1 class="page-title">Departamentos</h1>
        <p class="page-subtitle">Estrutura comercial e faturamento acumulado por área.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Novo departamento</a>
    </div>
</div>

<section class="card-app">
    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-diagram-3"></i>Nenhum departamento cadastrado ainda.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-app table-hover table-stack">
                <thead>
                    <tr>
                        <th>Departamento</th>
                        <th class="text-end">Vendedores</th>
                        <th class="text-end">Faturamento acumulado</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var share = maxTotal == 0 ? 0 : (int)(item.BilledTotal / maxTotal * 100);
                        <tr>
                            <td class="cell-main">
                                <div class="cell-person">
                                    <span class="kpi-icon tone-blue" style="width:36px;height:36px;font-size:1rem;background:var(--app-primary-soft)"><i class="bi bi-diagram-3"></i></span>
                                    <span class="name">@item.Department.Name</span>
                                </div>
                            </td>
                            <td data-label="Vendedores" class="text-end">@item.SellersCount</td>
                            <td data-label="Faturamento" class="text-end">
                                <span class="amount">@Format.Money(item.BilledTotal)</span>
                                <div class="progress mt-1 ms-auto" style="height:4px;max-width:160px;background:var(--app-surface-2)" role="presentation">
                                    <div class="progress-bar" style="width:@share%;background:#3987e5"></div>
                                </div>
                            </td>
                            <td>
                                <div class="row-actions">
                                    <a asp-action="Details" asp-route-id="@item.Department.Id" class="btn-icon" title="Detalhes" aria-label="Detalhes de @item.Department.Name"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Department.Id" class="btn-icon" title="Editar" aria-label="Editar @item.Department.Name"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn-icon danger" title="Excluir" aria-label="Excluir @item.Department.Name"
                                            data-delete-url="@Url.Action("Delete", new { id = item.Department.Id })" data-delete-name="@item.Department.Name">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@model SalesRecordFormViewModel
@{
    ViewData["Title"] = $"Editar venda #{Model.SalesRecord.Id}";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Vendas</a></li><li class="breadcrumb-item active">#@Model.SalesRecord.Id</li></ol></nav>
        <h1 class="page-title">Editar venda #@Model.SalesRecord.Id</h1>
        <p class="page-subtitle">Atualize os dados ou o status da venda.</p>
    </div>
</div>

<section class="card-app form-card">
    <form asp-action="Edit" asp-route-id="@Model.SalesRecord.Id" novalidate>
        <input type="hidden" asp-for="SalesRecord.Id" />
        <div class="card-app-body">
            <partial name="_Form" model="Model" />
        </div>
        <div class="card-app-header justify-content-end border-top border-bottom-0">
            <a asp-action="Index" class="btn btn-ghost">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i> Salvar alterações</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

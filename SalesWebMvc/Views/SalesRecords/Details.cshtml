@model SalesRecord
@{
    ViewData["Title"] = $"Venda #{Model.Id}";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Vendas</a></li><li class="breadcrumb-item active">#@Model.Id</li></ol></nav>
        <h1 class="page-title">Venda #@Model.Id</h1>
        <p class="page-subtitle">Registrada em @Format.Date(Model.Date)</p>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i> Editar</a>
        <button type="button" class="btn btn-ghost" data-delete-url="@Url.Action("Delete", new { id = Model.Id })" data-delete-name="a venda #@Model.Id">
            <i class="bi bi-trash3 me-1"></i> Excluir
        </button>
    </div>
</div>

<section class="card-app form-card">
    <div class="card-app-header">
        <div>
            <div class="kpi-label">Valor da venda</div>
            <div class="kpi-value mb-0">@Format.Money(Model.Amount)</div>
        </div>
        <status-badge status="@Model.Status" />
    </div>
    <div class="card-app-body">
        <dl class="detail-list">
            <dt>Data</dt>
            <dd>@Format.Date(Model.Date)</dd>
            <dt>Vendedor</dt>
            <dd>
                <a asp-controller="Sellers" asp-action="Details" asp-route-id="@Model.SellerId" class="cell-person">
                    <span class="avatar avatar-sm">@Format.Initials(Model.Seller?.Name ?? "?")</span>
                    <span class="name">@Model.Seller?.Name</span>
                </a>
            </dd>
            <dt>Departamento</dt>
            <dd><span class="dept-chip">@Model.Seller?.Department?.Name</span></dd>
        </dl>
    </div>
</section>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-ghost"><i class="bi bi-arrow-left me-1"></i> Voltar para a lista</a>
</div>

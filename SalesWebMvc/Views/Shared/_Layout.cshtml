@using SalesWebMvc.Helpers
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    string Active(string ctrl, string? act = null) =>
        string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase)
        && (act == null || string.Equals(action, act, StringComparison.OrdinalIgnoreCase)) ? "active" : "";

    var toast = new
    {
        type = TempData[ToastExtensions.TypeKey] as string,
        message = TempData[ToastExtensions.MessageKey] as string
    };
}
<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] · SalesWeb</title>
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Pular para o conteúdo</a>

    <div class="app-shell">
        <!-- ============ SIDEBAR ============ -->
        <aside class="sidebar" id="sidebar" aria-label="Navegação principal">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-graph-up-arrow"></i></span>
                <span class="brand-text">Sales<strong>Web</strong></span>
            </a>

            <nav class="sidebar-nav">
                <span class="nav-section">Visão geral</span>
                <a class="sidebar-link @Active("Home", "Index")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
                </a>

                <span class="nav-section">Gestão</span>
                <a class="sidebar-link @Active("SalesRecords")" asp-controller="SalesRecords" asp-action="Index">
                    <i class="bi bi-receipt"></i><span>Registro de Vendas</span>
                </a>
                <a class="sidebar-link @Active("Sellers")" asp-controller="Sellers" asp-action="Index">
                    <i class="bi bi-people"></i><span>Vendedores</span>
                </a>
                <a class="sidebar-link @Active("Departments")" asp-controller="Departments" asp-action="Index">
                    <i class="bi bi-diagram-3"></i><span>Departamentos</span>
                </a>

                <span class="nav-section">Sistema</span>
                <a class="sidebar-link @Active("Home", "Privacy")" asp-controller="Home" asp-action="Privacy">
                    <i class="bi bi-shield-lock"></i><span>Privacidade</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <a class="btn btn-primary w-100" asp-controller="SalesRecords" asp-action="Create">
                    <i class="bi bi-plus-lg me-1"></i> Nova venda
                </a>
            </div>
        </aside>
        <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

        <!-- ============ CONTEÚDO ============ -->
        <div class="app-main">
            <header class="topbar">
                <button class="icon-btn d-lg-none" id="sidebar-toggle" type="button" aria-label="Abrir menu" aria-controls="sidebar" aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>

                <form class="topbar-search" asp-controller="Sellers" asp-action="Index" method="get" role="search">
                    <i class="bi bi-search"></i>
                    <input type="search" name="search" placeholder="Buscar vendedores…" aria-label="Buscar vendedores" />
                    <kbd class="d-none d-md-inline">/</kbd>
                </form>

                <div class="topbar-actions">
                    @await Component.InvokeAsync("Notifications")

                    <div class="dropdown">
                        <button class="user-chip" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar">AD</span>
                            <span class="user-meta d-none d-sm-flex">
                                <span class="user-greeting">Olá, <strong>Administrador</strong></span>
                                <span class="user-role">admin@salesweb.com</span>
                            </span>
                            <i class="bi bi-chevron-down small text-secondary d-none d-sm-inline"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-item-text small text-secondary">Sessão de demonstração</span></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-lock me-2"></i>Privacidade</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <main id="main-content" role="main" class="page">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>&copy; @DateTime.Now.Year SalesWeb · ASP.NET Core MVC</span>
                <a asp-controller="Home" asp-action="Privacy">Privacidade</a>
            </footer>
        </div>
    </div>

    @* Formulário genérico usado pelos botões de exclusão com confirmação (SweetAlert2) *@
    <form id="delete-form" method="post" class="d-none">@Html.AntiForgeryToken()</form>

    <script id="toast-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toast))</script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmxc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model ErrorViewModel
@{
    ViewData["Title"] = "Ocorreu um erro";
}

<section class="card-app form-card mx-auto mt-4 text-center">
    <div class="card-app-body py-5">
        <div class="kpi-icon mx-auto mb-3" style="background:var(--app-danger-soft);color:var(--app-danger);width:64px;height:64px;font-size:1.8rem">
            <i class="bi bi-exclamation-octagon"></i>
        </div>
        <h1 class="page-title mb-2">@ViewData["Title"]</h1>
        <p class="page-subtitle mb-4">@(string.IsNullOrWhiteSpace(Model.Message) ? "Não foi possível processar sua solicitação." : Model.Message)</p>

        @if (Model.ShowRequestId)
        {
            <p class="small text-secondary">Request ID: <code>@Model.RequestId</code></p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2"><i class="bi bi-house me-1"></i> Voltar ao Dashboard</a>
    </div>
</section>
